{
  "uid": "${uid}",
  "title": "${title}",
  "tags": ["fixcomap", "slo", "opentelemetry"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "links": [
    { "title": "Trazas (Tempo)", "type": "link", "url": "/explore?left=%7B%22datasource%22:%22${traces_uid}%22,%22queries%22:%5B%7B%22query%22:%22%7Bresource.service.name%3D%5C%22${job}%5C%22%7D%22%7D%5D%7D", "icon": "external link" },
    { "title": "Repo", "type": "link", "url": "https://github.com/fixcomap/platform", "icon": "external link" }
  ],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Disponibilidad 30d (SLO ${slo * 100} %)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [{ "refId": "A", "instant": true, "expr": "1 - ((sum(increase(${req_count}{job=\"${job}\", http_response_status_code=~\"5..\"}[30d])) or vector(0)) / sum(increase(${req_count}{job=\"${job}\"}[30d])))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 3, "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": ${slo} } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "gauge", "title": "Presupuesto de error restante (30d)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [{ "refId": "A", "instant": true, "expr": "1 - (((sum(increase(${req_count}{job=\"${job}\", http_response_status_code=~\"5..\"}[30d])) or vector(0)) / sum(increase(${req_count}{job=\"${job}\"}[30d]))) / (1 - ${slo}))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "green", "value": 0.5 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3, "type": "stat", "title": "p95 latencia (5m, objetivo ${p95_target * 1000} ms)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [{ "refId": "A", "instant": true, "expr": "histogram_quantile(0.95, sum by (le) (rate(${req_bucket}{job=\"${job}\"}[5m])))" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": ${p95_target} } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4, "type": "stat", "title": "Peticiones / s (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [{ "refId": "A", "instant": true, "expr": "sum(rate(${req_count}{job=\"${job}\"}[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Peticiones / s por ruta",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [{ "refId": "A", "expr": "sum by (http_route) (rate(${req_count}{job=\"${job}\"}[$__rate_interval]))", "legendFormat": "{{http_route}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Tasa de error (5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [{ "refId": "A", "expr": "(sum(rate(${req_count}{job=\"${job}\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(${req_count}{job=\"${job}\"}[$__rate_interval]))", "legendFormat": "5xx / total" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 1, "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": ${1 - slo} } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Latencia p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(${req_bucket}{job=\"${job}\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(${req_bucket}{job=\"${job}\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(${req_bucket}{job=\"${job}\"}[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5, "lineWidth": 1, "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": ${p95_target} } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Peticiones por código de estado",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [{ "refId": "A", "expr": "sum by (http_response_status_code) (rate(${req_count}{job=\"${job}\"}[$__rate_interval]))", "legendFormat": "{{http_response_status_code}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Go: memoria en uso",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [{ "refId": "A", "expr": "sum by (instance) (go_memory_used_bytes{job=\"${job}\"})", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Go: goroutines e instancias",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${prom_uid}" },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (go_goroutine_count{job=\"${job}\"})", "legendFormat": "goroutines {{instance}}" },
        { "refId": "B", "expr": "count(count by (instance) (go_goroutine_count{job=\"${job}\"}))", "legendFormat": "instancias" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [ { "matcher": { "id": "byName", "options": "instancias" }, "properties": [ { "id": "custom.drawStyle", "value": "bars" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
